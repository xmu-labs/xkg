{
  "name": "@xmu-labs/xkg",
  "version": "1.6.1",
  "description": "xkg — Turn what you discover into context your AI workers can use. Capture once, then brief, plan, and execute with any MCP-compatible tool.",
  "type": "module",
  "bin": {
    "mnemos-capture": "dist/cli/index.js",
    "xkg": "dist/cli/index.js",
    "xmu": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:cli": "tsc -p cli/tsconfig.json",
    "prepublishOnly": "npm run build:cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "xkg",
    "xmu",
    "knowledge",
    "capture",
    "claude",
    "claude-code",
    "mcp",
    "agents",
    "agentic",
    "llm",
    "workflow"
  ],
  "author": "Sofía Padrón Valdez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmu-labs/xkg.git"
  },
  "homepage": "https://github.com/xmu-labs/xkg",
  "files": [
    "dist/cli/",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@neondatabase/serverless": "^1.2.0",
    "next": "^16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
